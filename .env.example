# Contact form delivery. Configure ONE of the options below.
# Without any option, submissions are logged in development and rejected
# (with a "please email us" fallback message) in production.

# Option 1: Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_FROM_EMAIL="DocsFlow AI <noreply@docsflowai.net>"
# Defaults to siteConfig.contact.general when empty.
CONTACT_TO_EMAIL=

# Option 2: POST submissions as JSON to your own endpoint or automation tool.
CONTACT_WEBHOOK_URL=
